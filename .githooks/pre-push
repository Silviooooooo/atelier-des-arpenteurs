#!/bin/sh
# Contrôle avant chaque envoi (SPECIFICATION.md, § 10.3 et § 11).
#
# Lance tous les contrôles ; au moindre échec, l'envoi est refusé et rien ne
# part sur GitHub. Il s'installe une fois par poste, sans --global :
#   git config core.hooksPath .githooks
# Ne jamais le contourner (--no-verify) : un envoi refusé se corrige.
#
# Les contrôles portent sur l'arbre de travail : il doit donc être celui du
# commit envoyé, sans modification ni fichier nouveau hors des commits.

# Hérité d'un node --test, NODE_TEST_CONTEXT ferait passer un échec pour un
# succès (revue du groupe 4).
unset NODE_TEST_CONTEXT

if ! command -v node >/dev/null 2>&1; then
  echo "Envoi refusé : node introuvable. Lancez l'envoi depuis un terminal où la commande node répond (Node 22 ou plus récent)."
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "Envoi refusé : des modifications ne sont pas commitées, ou des fichiers ne sont pas suivis."
  echo "Les contrôles doivent porter sur ce qui part : commitez-les, ou retirez-les, puis renvoyez."
  git status --short | head -20
  exit 1
fi

# Quatre fichiers de contrôles à la fois, et non un par cœur : mesuré le
# 27/10/2026 (lot 4.3), la suite à onze fichiers à la fois poussait la mémoire
# du poste à 21 Go, et trois contrôles lourds passaient leur délai ; à quatre,
# elle passait entière, plus vite (6 min 23 s contre 8 min 31 s), sous 20,2 Go
# (SPECIFICATION.md, § 10.3).
echo "Contrôles avant l'envoi (node --test, quatre fichiers à la fois)…"
journal=$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/atelier-pre-push.$$")
if node --test --test-concurrency=4 >"$journal" 2>&1; then
  grep -E '^(ℹ|#) (tests|pass|fail) ' "$journal"
  rm -f "$journal"
  exit 0
fi
grep -E '^✖|^not ok|^(ℹ|#) (tests|pass|fail) ' "$journal" | head -40
rm -f "$journal"
echo ""
echo "Envoi refusé : des contrôles échouent. Corrigez-les, puis renvoyez."
echo "Ne contournez jamais ce contrôle (--no-verify)."
exit 1
